{
  "root": true,
  "ignorePatterns": ["**/*.spec.js", "**/*.test.js", "**/node_modules/**", "build/**"],
  "extends": ["google", "prettier", "plugin:react/jsx-runtime", "../.eslintrc"],
  "parserOptions": {
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "react/react-in-jsx-scope": "off",
    "unused-imports/no-unused-imports": "warn",
    "unused-imports/no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "varsIgnorePattern": "^(_|mod|fun)$",
        "args": "after-used",
        "argsIgnorePattern": "^(_|req|res|reply|next)$"
      }
    ]
  },
  "plugins": ["react", "only-warn", "unused-imports"],
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
